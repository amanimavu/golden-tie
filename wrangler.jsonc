{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "compatibility_date": "2026-08-07",
    // `global_fetch_strictly_public` removed so local dev can reach the
    // Directus CMS at http://goldentiecms.local (a private address the flag
    // blocks). Safe here: the only fetch targets are api.resend.com
    // (hardcoded) and DIRECTUS_URL (config, never user input) — no
    // user-controlled fetch URL to protect against. Restore it (or move it
    // to an `env.production` block deployed with `wrangler deploy --env
    // production`) if a user-influenced fetch is ever added.
    "compatibility_flags": [],
    "name": "golden-tie",
    "main": "@astrojs/cloudflare/entrypoints/server",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
    },
    "observability": {
        "enabled": true,
    },
    // Non-secret only — RESEND_API_KEY stays out of this file (git-tracked)
    // and lives in .dev.vars locally / Cloudflare dashboard secrets in prod.
    "vars": {
        "CONTACT_TO_EMAIL": "admin@goldentie.africa",
        "CONTACT_FROM_EMAIL": "contact@goldentie.africa",
        "DIRECTUS_URL": "http://goldentiecms.local",
    },
}
