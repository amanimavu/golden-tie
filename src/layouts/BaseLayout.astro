---
import "../styles/global.css";
import logoSrc from "../lib/golden-tie-logo.svg?url";

export interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const year = new Date().getFullYear();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
		<link rel="shortcut icon" href="/favicon/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
		<link rel="manifest" href="/favicon/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Manrope:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="wrap brand-inline">
			<a class="wordmark" href="/#top">
				<img class="logo" src={logoSrc} alt="Golden Tie" width="140" height="106" />
			</a>
		</div>

		<div class="nav-fixed">
			<div class="wrap nav-fixed-inner">
				<nav class="nav-capsule" aria-label="Primary">
					<ul class="nav-links">
						<li><a class="pill pill-outline" href="/#about">About</a></li>
						<li><a class="pill pill-outline" href="/#subsidiaries">Subsidiaries</a></li>
						<li><a class="pill pill-filled" href="/csr">Corporate Social Responsibility</a></li>
					</ul>
				</nav>
			</div>
		</div>

		<slot />

		<footer class="site-footer">
			<div class="wrap footer-inner">
				<div class="footer-brand">
					<img class="logo footer-logo" src={logoSrc} alt="Golden Tie" width="120" height="91" />
					<div class="footer-brand-text">
						<p>&copy; {year} Golden Tie Limited. All rights reserved.</p>
						<p class="contact">Get in touch — contact details coming soon.</p>
					</div>
				</div>

				<ul class="social-links">
					<li>
						<a href="#" aria-label="Facebook">
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.326-.043-1.557-.14-2.857-.14C11.928 2 10 3.657 10 6.7v2.8H7v4h3V22h4v-8.5z" />
							</svg>
						</a>
					</li>
					<li>
						<a href="#" aria-label="Instagram">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
								<rect x="2.5" y="2.5" width="19" height="19" rx="5" />
								<circle cx="12" cy="12" r="4.5" />
								<circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
							</svg>
						</a>
					</li>
					<li>
						<a href="#" aria-label="X (Twitter)">
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M18.9 2H22l-7.6 8.7L23 22h-6.9l-5.4-6.7L4.6 22H1.5l8.1-9.3L1 2h7l4.9 6.1L18.9 2zm-1.2 18h1.9L6.4 3.9H4.4L17.7 20z" />
							</svg>
						</a>
					</li>
					<li>
						<a href="#" aria-label="LinkedIn">
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3V9zm7 0h3.8v1.7h.05c.53-1 1.83-2 3.77-2 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.5c0-1.3-.02-3-1.83-3-1.83 0-2.1 1.43-2.1 2.9V21h-4V9z" />
							</svg>
						</a>
					</li>
				</ul>
			</div>
		</footer>

		<script>
			document.documentElement.classList.add("js");

			const prefersReduced = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;
			const targets = document.querySelectorAll("[data-reveal]");

			if (prefersReduced || !("IntersectionObserver" in window)) {
				targets.forEach((el) => el.classList.add("is-visible"));
			} else {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add("is-visible");
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.2 },
				);
				targets.forEach((el) => observer.observe(el));
			}

			// Hide-on-scroll logo: sticks in place for a beat once you start
			// scrolling down, THEN fades away — not an instant hide. If you
			// reverse direction before that beat elapses, the pending hide
			// is cancelled and it just stays put. Reappears the same way:
			// after settling back at the top for a beat. The nav capsule is
			// unaffected (already fixed).
			const brand = document.querySelector(".brand-inline");
			if (brand) {
				if (prefersReduced || !("requestAnimationFrame" in window)) {
					brand.classList.add("is-visible");
				} else {
					const TOP_THRESHOLD = 10;
					const STICK_DELAY = 150;
					const SETTLE_DELAY = 100;
					// Ignore scroll events for a beat after load — a fresh
					// page load can fire a stray scroll event or two on its
					// own (fragment navigation, async image layout shifts)
					// before things settle, and those shouldn't be able to
					// hide the logo before the user has actually scrolled.
					const LOAD_GRACE_PERIOD = 400;

					let lastY = window.scrollY;
					let hideTimer: ReturnType<typeof setTimeout> | undefined;
					let showTimer: ReturnType<typeof setTimeout> | undefined;
					let ticking = false;
					const loadedAt = performance.now();

					brand.classList.add("is-visible");

					function handleScroll() {
						if (performance.now() - loadedAt < LOAD_GRACE_PERIOD) {
							lastY = window.scrollY;
							return;
						}
						const y = window.scrollY;
						const goingDown = y > lastY;
						const goingUp = y < lastY;
						lastY = y;

						if (y <= TOP_THRESHOLD) {
							clearTimeout(hideTimer);
							hideTimer = undefined;
							if (!showTimer) {
								showTimer = setTimeout(() => {
									brand!.classList.add("is-visible");
									showTimer = undefined;
								}, SETTLE_DELAY);
							}
						} else if (goingDown) {
							clearTimeout(showTimer);
							showTimer = undefined;
							if (!hideTimer && brand!.classList.contains("is-visible")) {
								hideTimer = setTimeout(() => {
									brand!.classList.remove("is-visible");
									hideTimer = undefined;
								}, STICK_DELAY);
							}
						} else if (goingUp) {
							// Reversed before the stick delay elapsed — cancel
							// the pending hide so it just stays visible.
							clearTimeout(hideTimer);
							hideTimer = undefined;
						}
					}

					window.addEventListener(
						"scroll",
						() => {
							if (!ticking) {
								requestAnimationFrame(() => {
									handleScroll();
									ticking = false;
								});
								ticking = true;
							}
						},
						{ passive: true },
					);
				}
			}
		</script>
	</body>
</html>
