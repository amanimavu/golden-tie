---
import "../styles/global.css";
import logoSrc from "../lib/golden-tie-logo.svg?url";
import defaultOgImage from "../lib/images/hero-image.png";

export interface Props {
	title: string;
	description: string;
    image?:ImageMetadata
}

const { title, description,  image = defaultOgImage } = Astro.props;
const year = new Date().getFullYear();

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image.src, Astro.site);

const organizationSchema = {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Golden Tie Ltd",
    url: Astro.site?.toString(),
    logo: new URL(logoSrc, Astro.site).toString(),
    telephone: "+254759080224",
    email: "contact@goldentie.africa",
};
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
		<link rel="shortcut icon" href="/favicon/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
		<link rel="manifest" href="/favicon/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />

        <meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />

        <meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Manrope:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>

        <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
	</head>
	<body>
		<div class="wrap brand-inline">
			<a class="wordmark" href="/#top">
				<img class="logo" src={logoSrc} alt="Golden Tie" width="140" height="106" />
			</a>
		</div>

		<div class="nav-fixed">
			<div class="wrap nav-fixed-inner">
				<nav class="nav-capsule" aria-label="Primary">
					<ul class="nav-links">
						<li><a class="pill pill-outline" href="/#about">About</a></li>
						<li><a class="pill pill-outline" href="/#subsidiaries">Subsidiaries</a></li>
						<li><a class="pill pill-outline" href="/#contact">Contact</a></li>
						<li>
							<a class="pill pill-filled" href="/csr">Corporate Social Responsibility</a>
						</li>
					</ul>
				</nav>

				<button
					type="button"
					class="nav-toggle"
					aria-expanded="false"
					aria-controls="mobile-drawer"
					aria-label="Open menu"
					data-drawer-toggle
				>
					<span class="nav-toggle-bar" aria-hidden="true"></span>
					<span class="nav-toggle-bar" aria-hidden="true"></span>
					<span class="nav-toggle-bar" aria-hidden="true"></span>
				</button>
			</div>
		</div>

		<div class="mobile-drawer" id="mobile-drawer" data-drawer>
			<div class="wrap mobile-drawer-inner">
				<button
					type="button"
					class="mobile-drawer-close"
					aria-label="Close menu"
					data-drawer-close
				>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
					</svg>
				</button>

				<nav aria-label="Mobile">
					<ul class="mobile-drawer-links">
						<li><a href="/#about" data-drawer-close>About</a></li>
						<li><a href="/#subsidiaries" data-drawer-close>Subsidiaries</a></li>
						<li><a href="/#contact" data-drawer-close>Contact</a></li>
						<li>
							<a class="pill pill-filled" href="/csr" data-drawer-close>
								Corporate Social Responsibility
							</a>
						</li>
					</ul>
				</nav>
			</div>
		</div>

		<slot />

		<footer class="site-footer">
			<div class="wrap footer-inner">
				<div class="footer-brand">
					<img class="logo footer-logo" src={logoSrc} alt="Golden Tie" width="120" height="91" />
					<div class="footer-brand-text">
						<p>&copy; {year} Golden Tie Limited. All rights reserved.</p>
						<p class="contact">
							<a href="/#contact">Get in touch</a>
						</p>
					</div>

					<ul class="social-links">
						<li>
							<a href="#" aria-label="Facebook">
								<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.326-.043-1.557-.14-2.857-.14C11.928 2 10 3.657 10 6.7v2.8H7v4h3V22h4v-8.5z" />
								</svg>
							</a>
						</li>
						<li>
							<a href="https://www.instagram.com/goldentieltd/" aria-label="Instagram">
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.6"
									aria-hidden="true"
								>
									<rect x="2.5" y="2.5" width="19" height="19" rx="5" />
									<circle cx="12" cy="12" r="4.5" />
									<circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
								</svg>
							</a>
						</li>
						<li>
							<a href="https://www.tiktok.com/@goldentielimited" aria-label="Tiktok">
								<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d="M12.525.02c1.31-.02 2.61-.01 3.91.04c.08 1.53.63 3.09 1.75 4.17c1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97c-.57-.26-1.1-.59-1.62-.93v8.12c0 4.26-3.46 7.72-7.72 7.72c-4.26 0-7.72-3.46-7.72-7.72c0-4.26 3.46-7.72 7.72-7.72c.38 0 .76.03 1.14.08v4.06c-.37-.04-.75-.06-1.14-.06c-2.02 0-3.66 1.64-3.66 3.66c0 2.02 1.64 3.66 3.66 3.66c2.02 0 3.66-1.64 3.66-3.66V.02z" />
                                </svg>
							</a>
						</li>
						<li>
							<a href="#" aria-label="LinkedIn">
								<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3V9zm7 0h3.8v1.7h.05c.53-1 1.83-2 3.77-2 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.5c0-1.3-.02-3-1.83-3-1.83 0-2.1 1.43-2.1 2.9V21h-4V9z" />
								</svg>
							</a>
						</li>
					</ul>
				</div>

				<div class="footer-columns">
					<div class="footer-col">
						<p class="footer-col-heading">Navigate</p>
						<ul class="footer-nav">
							<li><a href="/csr">CSR</a></li>
							<li><a href="/blogs">Blogs</a></li>
							<li><a href="/#about">About</a></li>
							<li><a href="/#contact">Contact</a></li>
							<li><a href="/#subsidiaries">Subsidiaries</a></li>
						</ul>
					</div>

					<div class="footer-col">
						<p class="footer-col-heading">Reach us</p>
						<!-- Placeholder — swap for the real registered contact details before launch. -->
						<ul class="footer-contact">
							<li>Nairobi, Kenya</li>
							<li><a href="tel:+254759080224">+254759080224</a></li>
							<li><a href="mailto:contact@goldentie.africa">contact@goldentie.africa</a></li>
						</ul>
					</div>
				</div>
			</div>
		</footer>

		<script>
			document.documentElement.classList.add("js");

			const prefersReduced = window.matchMedia(
				"(prefers-reduced-motion: reduce)",
			).matches;
			const targets = document.querySelectorAll("[data-reveal]");

			if (prefersReduced || !("IntersectionObserver" in window)) {
				targets.forEach((el) => el.classList.add("is-visible"));
			} else {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add("is-visible");
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.2 },
				);
				targets.forEach((el) => observer.observe(el));
			}

			// Hide-on-scroll logo: sticks in place for a beat once you start
			// scrolling down, THEN fades away — not an instant hide. If you
			// reverse direction before that beat elapses, the pending hide
			// is cancelled and it just stays put. Reappears the same way:
			// after settling back at the top for a beat. The nav capsule is
			// unaffected (already fixed).
			const brand = document.querySelector(".brand-inline");
			if (brand) {
				if (prefersReduced || !("requestAnimationFrame" in window)) {
					brand.classList.add("is-visible");
				} else {
					const TOP_THRESHOLD = 10;
					const STICK_DELAY = 150;
					const SETTLE_DELAY = 100;

					let lastY = window.scrollY;
					let hideTimer: ReturnType<typeof setTimeout> | undefined;
					let showTimer: ReturnType<typeof setTimeout> | undefined;
					let ticking = false;

					// Reflect the actual scroll position on load — a reload
					// while already scrolled down must not show the logo,
					// it should only ever start visible when the page is
					// genuinely at the top.
					if (lastY <= TOP_THRESHOLD) {
						brand.classList.add("is-visible");
					}

					function handleScroll() {
						const y = window.scrollY;
						const goingDown = y > lastY;
						const goingUp = y < lastY;
						lastY = y;

						if (y <= TOP_THRESHOLD) {
							clearTimeout(hideTimer);
							hideTimer = undefined;
							if (!showTimer) {
								showTimer = setTimeout(() => {
									brand!.classList.add("is-visible");
									showTimer = undefined;
								}, SETTLE_DELAY);
							}
						} else if (goingDown) {
							clearTimeout(showTimer);
							showTimer = undefined;
							if (!hideTimer && brand!.classList.contains("is-visible")) {
								hideTimer = setTimeout(() => {
									brand!.classList.remove("is-visible");
									hideTimer = undefined;
								}, STICK_DELAY);
							}
						} else if (goingUp) {
							// Reversed before the stick delay elapsed — cancel
							// the pending hide so it just stays visible.
							clearTimeout(hideTimer);
							hideTimer = undefined;
						}
					}

					window.addEventListener(
						"scroll",
						() => {
							if (!ticking) {
								requestAnimationFrame(() => {
									handleScroll();
									ticking = false;
								});
								ticking = true;
							}
						},
						{ passive: true },
					);
				}
			}

			// Mobile nav drawer: full-viewport overlay toggled by the
			// hamburger button. Body scroll is locked while it's open, and
			// it closes on the close button, any nav link, or Escape.
			const drawerToggle = document.querySelector("[data-drawer-toggle]");
			const drawer = document.querySelector("[data-drawer]");

			if (drawerToggle && drawer) {
				const closers = drawer.querySelectorAll("[data-drawer-close]");
				const closeButton = drawer.querySelector<HTMLElement>(".mobile-drawer-close");

				function openDrawer() {
					drawer!.classList.add("is-open");
					drawerToggle!.setAttribute("aria-expanded", "true");
					document.body.classList.add("drawer-open");
					closeButton?.focus();
				}

				function closeDrawer() {
					drawer!.classList.remove("is-open");
					drawerToggle!.setAttribute("aria-expanded", "false");
					document.body.classList.remove("drawer-open");
				}

				drawerToggle.addEventListener("click", () => {
					if (drawer!.classList.contains("is-open")) {
						closeDrawer();
					} else {
						openDrawer();
					}
				});

				closers.forEach((el) => el.addEventListener("click", closeDrawer));

				document.addEventListener("keydown", (event) => {
					if (event.key === "Escape" && drawer!.classList.contains("is-open")) {
						closeDrawer();
						(drawerToggle as HTMLElement).focus();
					}
				});
			}
		</script>
	</body>
</html>
