---
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts, coverImageUrl, type Post } from "../../lib/directus";

// Prerendered: one HTML page per published post, built from Directus at
// build time. New/changed posts require a rebuild + redeploy.
export const getStaticPaths = (async () => {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}) satisfies GetStaticPaths;

const { post } = Astro.props as { post: Post };

const cover = coverImageUrl(post);
const dateFormatter = new Intl.DateTimeFormat("en", {
	year: "numeric",
	month: "long",
	day: "numeric",
});
---

<BaseLayout title={`${post.title} — Golden Tie Limited`} description={post.excerpt}>
	{
		cover ? (
			<header class="page-header post-photo-header" id="top">
				<Image
					class="page-header-bg"
					src={cover}
					inferSize
					widths={[768, 1280, 1920]}
					sizes="100vw"
					alt=""
					loading="eager"
					fetchpriority="high"
				/>
				<div class="page-header-scrim" aria-hidden="true" />
				<div class="wrap page-header-grid">
					<div class="page-header-content">
						<a class="pill pill-outline blog-back" href="/blogs">
							&larr; Blog
						</a>
						<p class="eyebrow">
							{dateFormatter.format(new Date(post.publish_date))}
							{post.tags.length > 0 && ` — ${post.tags.join(", ")}`}
						</p>
						<h1 class="page-title">{post.title}</h1>
					</div>
				</div>
			</header>
		) : (
			<header class="blog-post-header" id="top">
				<div class="wrap">
					<a class="pill pill-outline blog-back" href="/blogs">
						&larr; Blog
					</a>
					<p class="eyebrow">
						{dateFormatter.format(new Date(post.publish_date))}
						{post.tags.length > 0 && ` — ${post.tags.join(", ")}`}
					</p>
					<h1 class="page-title">{post.title}</h1>
				</div>
			</header>
		)
	}

	<main>
		<article class="post-article">
			<div class="wrap">
				{/* Body is admin-authored rich text from Directus, not visitor input. */}
				<div class="post-body" set:html={post.body} />
			</div>
		</article>
	</main>
</BaseLayout>
