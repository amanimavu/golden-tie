---
import { Image } from "astro:assets";

import BaseLayout from "../layouts/BaseLayout.astro";
import { getPrograms, programImageUrl } from "../lib/directus";
import csrImage from "../lib/social-responsibility.jpg";

// Programs (text + image) come from the CMS at build time. Images are
// Directus files, fetched and optimised by <Image> during the build.
const programs = await getPrograms();
---

<BaseLayout
	title="Corporate Social Responsibility — Golden Tie Limited"
	description="The programs Golden Tie Limited runs across its energy, education, and environmental work — reforestation, waste-oil diversion, and skills training."
>
	<header class="page-header" id="top">
		<img class="page-header-bg" src={csrImage.src} alt="" />
		<div class="page-header-scrim" aria-hidden="true"></div>
		<div class="wrap page-header-grid">
			<div class="page-header-content">
				<p class="eyebrow">Corporate Social Responsibility</p>
				<h1 class="page-title">Responsibility,<br />built into<br />how we operate</h1>
				<p class="page-lede">
					As a conglomerate spanning energy, education, and technology, we treat
					responsibility as part of how each business runs day to day — not a
					separate initiative bolted on after the fact.
				</p>
			</div>
		</div>
	</header>

	<main>
		<section class="programs subsidiaries" id="programs" aria-labelledby="programs-heading">
			<div class="wrap">
				<h2 id="programs-heading" class="visually-hidden">Programs</h2>
				<p class="eyebrow programs-label">Programs</p>
				{
					programs.map((program) => {
						const imageUrl = programImageUrl(program);
						return (
							<article class="venture" data-reveal>
								<p class="eyebrow">{program.category}</p>
								<span class="hairline" aria-hidden="true" />
								<h3 class="venture-name">{program.name}</h3>
								<p class="program-lead" set:html={program.lead} />
								<p class="venture-desc">{program.description}</p>
								{imageUrl && (
									<Image
										class="program-media"
										src={imageUrl}
										inferSize
										alt={program.image_alt}
										widths={[400, 640, 960]}
										sizes="(min-width: 901px) 40vw, 100vw"
										loading="lazy"
									/>
								)}
							</article>
						);
					})
				}
			</div>
		</section>
	</main>
</BaseLayout>
