---
import BaseLayout from "../layouts/BaseLayout.astro";
import NoiseReveal from "../components/NoiseReveal.astro";

const subsidiaries = [
	{
		name: "Tipping App",
		category: "Fintech — Digital Tipping",
		description:
			"A digital tipping platform connecting service staff with the customers they serve.",
	},
	{
		name: "Biodiesel Feedstock Trader",
		category: "Energy — Feedstock Trading",
		description:
			"Sourcing and trading waste-oil feedstock for sustainable biodiesel production.",
	},
	{
		name: "Training Institute",
		category: "Education — Skills Training",
		description:
			"Hands-on training programs building skills for hospitality, service, and entrepreneurship.",
	},
];

const interests = [
	"Green Energy",
	"Skills focused Education",
	"Technology",
];
---

<BaseLayout
	title="Golden Tie Limited"
	description="Golden Tie Limited is a conglomerate with interests across multiple industries, including a Tipping App, a Biodiesel Feedstock Trader business, and a Training Institute."
>
	<header class="hero" id="top">
		<div class="wrap hero-grid">
			<div class="hero-content">
				<h1 class="hero-headline">Golden Tie Limited</h1>
				<p class="hero-sub">
					A conglomerate with interests across multiple industries — currently
					building a Tipping App, a Biodiesel Feedstock Trader business, and a
					Training Institute.
				</p>
			</div>
			<div class="hero-graphic">
				<NoiseReveal src="/images/hero-placeholder.png" width={640} height={640} />
			</div>
		</div>
	</header>

	<main>
		<section class="subsidiaries" id="subsidiaries" aria-labelledby="subsidiaries-heading">
			<h2 id="subsidiaries-heading" class="visually-hidden">Subsidiaries</h2>
			<div class="wrap">
				{
					subsidiaries.map((sub) => (
						<article class="venture" data-reveal>
							<p class="eyebrow">{sub.category}</p>
							<span class="hairline" aria-hidden="true" />
							<h3 class="venture-name">{sub.name}</h3>
							<p class="venture-desc">{sub.description}</p>
						</article>
					))
				}
			</div>
		</section>

		<section class="about" id="about" aria-labelledby="about-heading">
			<div class="wrap">
				<h2 id="about-heading">About</h2>
				<p>
					Golden Tie Limited brings together a diverse portfolio of ventures under
					one holding company — from <span class="accent">Green Energy</span> to <span class="accent">Skill Set Education</span> and <span class="accent">Technology</span> — each built with the same standard
					of execution.
				</p>
				<ul class="interest-list">
					{interests.map((interest) => <li>{interest}</li>)}
				</ul>
			</div>
		</section>

		<section class="contact-section" id="contact" aria-labelledby="contact-heading">
			<div class="wrap contact-grid">
				<div class="contact-intro">
					<p class="eyebrow">Get in Touch</p>
					<h2 id="contact-heading">Send us a message</h2>
					<p>
						Questions about our ventures, partnerships, or anything else — reach
						out and we'll get back to you.
					</p>
				</div>

				<form class="contact-form" id="contact-form" data-enabled="true" novalidate>
					<label>
						<span>Name</span>
						<input type="text" name="name" autocomplete="name" required maxlength="120" />
					</label>
					<label>
						<span>Email</span>
						<input type="email" name="email" autocomplete="email" required />
					</label>
					<label>
						<span>Message</span>
						<textarea name="message" rows="5" required maxlength="4000"></textarea>
					</label>
					<label class="contact-honeypot" aria-hidden="true">
						<span>Company</span>
						<input type="text" name="company" tabindex="-1" autocomplete="off" />
					</label>
					<button type="submit" class="pill pill-filled">Send Message</button>
					<p class="contact-status" role="status" aria-live="polite"></p>
				</form>
			</div>
		</section>
	</main>
</BaseLayout>

<script>
	import { actions, isInputError } from "astro:actions";

	const form = document.querySelector<HTMLFormElement>("#contact-form");
	const status = form?.querySelector<HTMLParagraphElement>(".contact-status");
	const button = form?.querySelector<HTMLButtonElement>("button[type='submit']");

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (!status || !button) return;

		// Mailbox/send infra isn't set up yet — bail out before ever
		// calling the action, regardless of the button's disabled state.
		if (form.dataset.enabled !== "true") return;

		button.disabled = true;
		status.textContent = "Sending…";

		const { error } = await actions.contact(new FormData(form));

		if (error) {
			status.textContent = isInputError(error)
				? "Please check the fields above and try again."
				: "Something went wrong. Please try again later.";
			button.disabled = false;
			return;
		}

		form.reset();
		status.textContent = "Message sent — we'll be in touch soon.";
		button.disabled = false;
	});
</script>
